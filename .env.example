# Optional. Without a key, the assistant falls back to a deterministic
# local parser so the demo still works offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Use an ambient ANTHROPIC_AUTH_TOKEN instead of ANTHROPIC_API_KEY.
# ORDERDESK_ENABLE_MODEL=1

# Force the deterministic local assistant even if a key is present.
# ORDERDESK_DISABLE_MODEL=1

# Optional SQLite location (default: data/orderdesk.db)
ORDERDESK_DB=
